{
  "name": "scm-static-site",
  "version": "1.0.0",
  "description": "Static site with GitHub Actions CI/CD, ESLint quality checks, and Jest unit tests",
  "private": true,
  "scripts": {
    "lint": "eslint js/",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/js/**/*.test.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.0.0"
  }
}
